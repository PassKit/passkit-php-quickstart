PASSKIT_ADDRESS=grpc.pub1.passkit.io
PASSKIT_PORT=443
PASSKIT_ROOT_CERT=./certs/ca-chain.pem
PASSKIT_PRIVATE_KEY=./certs/key.pem
PASSKIT_CERTIFICATE=./certs/certificate.pem
PASSKIT_CONNECTION_MODE=pool
PASSKIT_POOL_SIZE=5
# Optional: receive pass emails created by examples.
# PASSKIT_RECIPIENT_EMAIL=developer@example.com
# Required only for flights. Use the Pass Type Identifier uploaded to PassKit.
# PASSKIT_APPLE_CERTIFICATE=pass.com.yourcertificate
# Keep generated resources so you can inspect them. Delete them manually afterwards.
PASSKIT_KEEP_ASSETS=false
# Enables intentionally broad bulk/segment operations in PassKitApi.
PASSKIT_ALLOW_DESTRUCTIVE=false
